<mvc:View xmlns:core="sap.ui.core" controllerName= "bbs.controller.App" 
          xmlns:mvc = "sap.ui.core.mvc" 
          xmlns ="sap.m" 
          xmlns:form="sap.ui.layout.form" 
>

    <form:SimpleForm editable="true">
        <form:title>
            <core:Title text="Employee Details" icon="sap-icon://customer"/>
        </form:title>
        <form:content>
            <Label text="Employee ID" />
            <Input id="idEmpId" width="5%"/>
            <Label text="Employee Name" />
            <Input id="idEmpName" width="20%"/>
            <Label text="Employee Salary" />
            <Input id="idEmpSal" width="10%"/>
            <Label text="Currency"/>
            <Input id="idEmpCurr" width="5%"/>
            <Label />
            <Button id="idBtn" text="Reload" press="onReload" width="10%"/>
        </form:content>
    </form:SimpleForm>

